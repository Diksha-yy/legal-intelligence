# ==========================================
# Legal Intelligence AI Configuration
# ==========================================

# Server Port & Host
PORT=8000
HOST=0.0.0.0

# Security
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRATION_SECONDS=604800

# Firebase Configuration (Optional - falls back to local SQLite/JWT if not provided)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CONFIG_JSON=
FIREBASE_STORAGE_BUCKET=

# Frontend Base URL (for Vite build and CORS)
VITE_API_BASE_URL=http://localhost:8000
